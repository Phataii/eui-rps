@{
    ViewData["Title"] = "Verify Access Code";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow p-4">
        <h3 class="text-center mb-3">Result Access Verification</h3>

        <form id="verifyForm">
            <div class="form-group mb-3">
                <label for="matNumber">Matric Number</label>
                <input type="text" class="form-control" id="matNumber" placeholder="e.g. CSC/2020/001" required />
            </div>

            <div class="form-group mb-3">
                <label for="uniqueCode">Access Code</label>
                <input type="text" class="form-control" id="uniqueCode" placeholder="Enter your access code" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Verify</button>
        </form>

        <div id="message" class="mt-3 text-center text-danger">
            @ViewBag.Message
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById("verifyForm").addEventListener("submit", async function (e) {
    e.preventDefault();

    const matNumber = document.getElementById("matNumber").value.trim();
    const uniqueCode = document.getElementById("uniqueCode").value.trim();
    const msg = document.getElementById("message");

    msg.innerHTML = "Verifying...";
    msg.className = "text-info text-center";

    try {
        const response = await fetch("/api/result/verify-code", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ matNumber, uniqueCode })
        });

        if (response.ok) {
            msg.innerHTML = "Verification successful! Redirecting...";
            msg.className = "text-success text-center";

            setTimeout(() => {
                window.location.href = `/result?matNumber=${encodeURIComponent(matNumber)}`;
            }, 1200);
        } else {
            const err = await response.text();
            msg.innerHTML = err || "Invalid code.";
            msg.className = "text-danger text-center";
        }
    } catch (error) {
        msg.innerHTML = "Network error. Please try again.";
        msg.className = "text-danger text-center";
    }
});
</script>
}
